<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns="http://www.irs.gov/efile" xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.irs.gov/efile" elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

	<xsd:annotation>
		<xsd:documentation>
			<Description>Recipient Share Total Unitrust Dollar Percentage Statement</Description>
			<Purpose>Percentage of the total unitrust dollar amount payable to each recipient.
</Purpose>
			<TaxYear>2026</TaxYear>
			<MaturityLevel>Final Schema Version RL10A Drop 1</MaturityLevel>
			<ReleaseDate>May 28 2026</ReleaseDate>
		</xsd:documentation>
	</xsd:annotation>

	<xsd:include schemaLocation="../../../Common/efileTypes.xsd"/>

	<!-- ================================================================================ -->
	<!-- ========== Recipient Share Total Unitrust Dollar Percentage Statement ========== -->
	<!-- ================================================================================ -->

	<xsd:element name="RcpntShrTotUnitrustDolPctStmt">
		<xsd:annotation>
			<xsd:documentation>Recipient Share Total Unitrust Dollar Percentage Statement</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:complexContent>
				<xsd:extension base="RcpntShrTotUnitrustDolPctStmtType">
					<xsd:attributeGroup ref="DocumentAttributes">
						<xsd:annotation>
							<xsd:documentation>Common return document attributes</xsd:documentation>
						</xsd:annotation>
					</xsd:attributeGroup>
					<xsd:attribute name="documentName" type="xsd:string" fixed="RecipientShareTotalUnitrustDollarPercentageStatement">
						<xsd:annotation>
							<xsd:documentation>IRS internal use only. To avoid error in the return, do not include the attribute name or value.</xsd:documentation>
						</xsd:annotation>
					</xsd:attribute>
				</xsd:extension>
			</xsd:complexContent>
		</xsd:complexType>
	</xsd:element>

	<xsd:complexType name="RcpntShrTotUnitrustDolPctStmtType">
		<xsd:annotation>
			<xsd:documentation>Content model for Recipient Share Total Unitrust Dollar Percentage Statement</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>

			<!-- Repeating Group - Recipient Share Total Unitrust Dollar Percentage -->
			<xsd:element name="RcpntShrTotUnitrustDolPctGrp" type="RcpntShrTotUnitrustDolPctGrpType" minOccurs="2" maxOccurs="unbounded">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Repeating Group - Recipient Share Total Unitrust Dollar Percentage</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>

		</xsd:sequence>
	</xsd:complexType>

	<xsd:complexType name="RcpntShrTotUnitrustDolPctGrpType">
		<xsd:sequence>

			<!-- Line number of recipient in the order reported on Schedule A, Part III, Colum (a) -->
			<xsd:element name="RowId">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Line number of recipient in the order reported on Schedule A, Part III, Colum (a)</Description>
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="TextType">
						<xsd:pattern value="[1][a-z]+"/>
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>

			<!-- Percentage of total unitrust amount payable -->
			<xsd:element name="TotUnitrustAmtPayablePct" type="Decimal4RatioType">
				<xsd:annotation>
					<xsd:documentation>
						<Description>Percentage of total unitrust amount payable</Description>
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>

		</xsd:sequence>
	</xsd:complexType>

</xsd:schema>
